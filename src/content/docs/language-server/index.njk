{%- set setupIds = [] -%}
{%- for p in collections.all %}{% if p.url == "/docs/language-server/setup/" %}{% for item in p.data.docsToc %}{% set setupIds = (setupIds.push(item.href | replace("#", "")), setupIds) %}{% endfor %}{% endif %}{% endfor -%}
<section>
  <p class="eyebrow">Docs · language server</p>
  <h1>Language Server</h1>
  <p class="lede">
    Completions, hovers and diagnostics for your design system’s components,
    tokens and utilities, in your editor. See the
    <a href="/tools/language-server/">feature tour</a>.
  </p>

  <section id="how-it-works">
    <h2>How it works</h2>
    <ul>
      <li>It reads the component, token and utility manifests your team publishes, validated by the <a href="/docs/schemas/">schemas</a>.</li>
      <li>You point your editor or project at those manifests.</li>
      <li>It serves completions, hovers and diagnostics over the Language Server Protocol.</li>
    </ul>
  </section>

  <section id="get-started">
    <h2>Get started</h2>
    <div class="tool-cards" aria-label="Setup steps">
      <article class="tool-card">
        <h3><a href="/docs/language-server/setup/#install">Install in your editor</a></h3>
        <p>VS Code, Zed, or any LSP client.</p>
      </article>
      <article class="tool-card">
        <h3><a href="/docs/language-server/setup/#configure">Connect manifests</a></h3>
        <p>Package discovery or <code>ds.config.json</code>.</p>
      </article>
      <article class="tool-card">
        <h3><a href="/docs/language-server/setup/#troubleshoot">Troubleshoot</a></h3>
        <p>If suggestions are missing.</p>
      </article>
    </div>
  </section>

  <section id="requirements">
    <h2>Requirements</h2>
    <p>VS Code {{ site.languageServer.minVsCode }} or newer, or Node.js 20 or newer for other LSP clients.</p>
  </section>
</section>

{# Old deep links such as /docs/language-server/#vs-code lived on this URL before setup moved. #}
