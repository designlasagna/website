---
layout: docs.njk
permalink: /docs/schemas/v0.3/utilities/
title: Utilities — v0.3
description: JSON Schema reference for the Design Lasagna v0.3 utilities manifest.
schemaDocVersion: v0.3
schemaDocV04Href: /docs/schemas/v0.4/utilities/
docsToc:
  - label: Start here
    href: "#start"
  - label: Manifest fields
    href: "#manifest-fields"
  - label: Utility fields
    href: "#utility-fields"
  - label: Nested definitions
    href: "#definitions"
---
{%- set st = schemas.v03Utilities -%}
{%- set ref = st.ref -%}
{%- set utility = ref.definitions.UtilityClass -%}

{% from "schema-field-table.njk" import fieldTable with context %}

<section id="start">
  <p class="eyebrow">Schemas / v0.3</p>
  <h1>Utilities</h1>
  <p class="lede">{{ ref.description }}</p>
  {% include "schema-version-nav.njk" %}
  <aside class="schema-install" aria-labelledby="use-utilities-schema">
    <div class="schema-install__intro">
      <p class="schema-install__kicker">Start here</p>
      <h2 id="use-utilities-schema">Use this schema</h2>
      <p>Set <code>$schema</code> in a utilities manifest to enable validation and editor support.</p>
    </div>
    <dl class="schema-install__sources">
      <div><dt>Schema URL</dt><dd><a href="{{ st.canonicalUrl }}"><code>{{ st.canonicalUrl }}</code></a></dd></div>
      <div><dt>npm package</dt><dd><code>{{ st.npmImportPath }}</code></dd></div>
    </dl>
  </aside>

  <h2>Minimal example</h2>
  <p>This manifest declares a flat <code>utilities</code> list. The schema also allows a
  <code>categories</code> manifest, in which each category groups its utilities —
  every utility class follows the same shape either way.</p>
  <pre class="json-example"><code>{{ st.minimalExample | jsonCode | safe }}</code></pre>
</section>

<section id="manifest-fields">
  <h2>Manifest fields</h2>
  <p><span class="required-field" aria-label="required">*</span> Required field. A manifest declares
  <code>categories</code> or <code>utilities</code> (one of the two), alongside <code>schemaVersion</code>.</p>
  {{ fieldTable(ref.properties, 'manifest', 'v03Utilities') }}
</section>

<section id="utility-fields">
  <h2>Utility class fields</h2>
  <p>Each item in <code>utilities</code> follows this shape.</p>
  {{ fieldTable(utility.properties, 'UtilityClass', 'v03Utilities') }}
</section>

<section id="definitions">
  <h2>Nested definitions</h2>
  {% for entry in ref.definitions | dictsort %}
    {% set name = entry[0] %}
    {% set definition = entry[1] %}
    {% if name != 'UtilityClass' %}
    {% set definitionGuide = schemaDocs.v03Utilities._definitions[name] or {} %}
    <article class="schema-definition">
      <h3 id="definition-{{ name }}"><code>{{ name }}</code></h3>
      <p>{{ definitionGuide.summary or definition.description or 'See the raw schema for this definition.' }}</p>
      {% if definition.properties %}
        {{ fieldTable(definition.properties, name, 'v03Utilities') }}
      {% elif definition.additionalProperties === true %}
        <p>This definition accepts type-specific keys; the schema deliberately does not constrain the object further.</p>
      {% elif definition.type %}
        <p><code>{{ definition.type }}</code></p>
      {% endif %}
      {% if definitionGuide.example %}
        <p><strong>Example usage</strong></p>
        <pre class="json-example"><code>{{ definitionGuide.example | jsonCode | safe }}</code></pre>
      {% endif %}
    </article>
    {% endif %}
  {% endfor %}
</section>

<section>
  <p><a class="link-back" href="/docs/schemas/">All schemas</a> · <a href="https://github.com/designlasagna/schemas">Schema source on GitHub</a></p>
</section>
