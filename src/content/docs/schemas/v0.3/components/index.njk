{%- set st = schemas.v03CemExtensions -%}
{%- set ref = st.ref -%}
{%- set lifecycle = ref.definitions.LifecycleFields -%}

{% from "schema-field-table.njk" import fieldTable with context %}

<section id="start">
  <p class="eyebrow">Schemas / v0.3</p>
  <h1>Components</h1>
  <p class="lede">{{ ref.description }}</p>
  {% include "schema-version-nav.njk" %}
  <p>This is <strong>not</strong> the Custom Elements Manifest (CEM) schema itself, and it
  defines no component format. It defines <em>extension</em> fields that a design
  system may add to CEM declarations and members to record lifecycle metadata:
  status, deprecation details, and migration targets.</p>
  <aside class="schema-install" aria-labelledby="use-components-schema">
    <div class="schema-install__intro">
      <p class="schema-install__kicker">Start here</p>
      <h2 id="use-components-schema">Use these extensions</h2>
      <p>Reference a definition with <code>$ref</code> when composing a component manifest schema.</p>
    </div>
    <dl class="schema-install__sources">
      <div><dt>Schema URL</dt><dd><a href="{{ st.canonicalUrl }}"><code>{{ st.canonicalUrl }}</code></a></dd></div>
      <div><dt>npm package</dt><dd><code>{{ st.npmImportPath }}</code></dd></div>
    </dl>
  </aside>

  <h2>Applying the extensions</h2>
  <p>The snippet below is a Custom Elements Manifest declaration with the
  extension fields applied: <code>status</code> on the declaration, and a
  deprecated attribute value with its migration path. Extension fields are
  additive — a valid CEM remains valid without them.</p>
  <pre class="json-example"><code>{{ st.minimalExample | jsonCode | safe }}</code></pre>
</section>

<section id="lifecycle-fields">
  <h2>Lifecycle fields</h2>
  <p>These optional fields may be added to a CEM declaration or to its members
  (attributes, methods, properties).</p>
  {{ fieldTable(lifecycle.properties, 'LifecycleFields', 'v03CemExtensions') }}
</section>

<section id="definitions">
  <h2>Extension definitions</h2>
  {% for entry in ref.definitions | dictsort %}
    {% set name = entry[0] %}
    {% set definition = entry[1] %}
    {% if name != 'LifecycleFields' %}
    {% set definitionGuide = schemaDocs.v03CemExtensions._definitions[name] or {} %}
    <article class="schema-definition">
      <h3 id="definition-{{ name }}"><code>{{ name }}</code></h3>
      <p>{{ definitionGuide.summary or definition.description or 'See the raw schema for this definition.' }}</p>
      {% if definition.properties %}
        {{ fieldTable(definition.properties, name, 'v03CemExtensions') }}
      {% elif definition.additionalProperties === true %}
        <p>This definition accepts type-specific keys; the schema deliberately does not constrain the object further.</p>
      {% elif definition.$ref %}
        <p><code>{{ definition.$ref }}</code></p>
      {% elif definition.type %}
        <p><code>{{ definition.type }}</code></p>
      {% endif %}
      {% if definitionGuide.example %}
        <p><strong>Example usage</strong></p>
        <pre class="json-example"><code>{{ definitionGuide.example | jsonCode | safe }}</code></pre>
      {% endif %}
    </article>
    {% endif %}
  {% endfor %}
</section>

<section>
  <p><a class="link-back" href="/docs/schemas/">All schemas</a> · <a href="https://github.com/designlasagna/schemas">Schema source on GitHub</a></p>
</section>
