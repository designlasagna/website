{%- set st = schemas.v04Utilities -%}
{%- set ref = st.ref -%}
{%- set utility = ref.definitions.UtilityClass -%}

{% from "schema-field-table.njk" import fieldTable with context %}

<section>
  <p class="eyebrow">Schemas / v0.4</p>
  <h1>Utilities</h1>
  <p class="lede">{{ ref.description }}</p>
  {% include "schema-version-nav.njk" %}
  <aside class="schema-install" aria-labelledby="use-utilities-schema">
    <div class="schema-install__intro">
      <h2 id="use-utilities-schema">Use this schema</h2>
      <p>Set <code>$schema</code> in a utilities manifest to enable validation and editor support.</p>
      <p>The reference below is generated from the published schema and augmented with reader guidance.</p>
    </div>
    <dl class="schema-install__sources">
      <div><dt>Raw schema</dt><dd><a href="{{ st.canonicalUrl }}">{{ st.canonicalUrl }}</a></dd></div>
      <div><dt>npm</dt><dd><a href="https://www.npmjs.com/package/@designlasagna/schemas"><code>{{ st.npmImportPath }}</code></a></dd></div>
      <div><dt>Repository</dt><dd><a href="https://github.com/designlasagna/schemas">designlasagna/schemas</a></dd></div>
    </dl>
  </aside>
  <h2>Minimal example</h2>
  <p>This manifest declares the flat <code>utilities</code> list. The schema also allows a
  <code>categories</code> manifest, in which each category groups its utilities —
  every utility class follows the same shape either way.</p>
  <pre class="json-example"><code>{{ st.minimalExample | jsonCode | safe }}</code></pre>
</section>

<section id="manifest-fields">
  <h2>Manifest fields</h2>
  <p>The root object is the resolved utilities manifest. Required fields are marked with <code>*</code>.
  A manifest declares <code>categories</code> or <code>utilities</code> (exactly one of the two), alongside <code>schemaVersion</code>.</p>
  {{ fieldTable(ref.properties, 'manifest', 'v04Utilities') }}
</section>

<section id="utility-fields">
  <h2>Utility fields</h2>
  <p>Each item in <code>utilities</code> — or in a category's <code>utilities</code> list — follows this shape.</p>
  {{ fieldTable(utility.properties, 'UtilityClass', 'v04Utilities') }}
</section>

<section id="definitions">
  <h2>Nested definitions</h2>
  <p>Reusable shapes referenced by the fields above.</p>
  <div class="schema-definition-list">
    {% for name, definition in ref.definitions | dictsort %}
      {% if name != 'UtilityClass' %}
      <article class="schema-definition">
        <h3 id="definition-{{ name }}"><code>{{ name }}</code></h3>
        {% set definitionGuide = schemaDocs.v04Utilities._definitions and schemaDocs.v04Utilities._definitions[name] or {} %}
        <p>{{ definitionGuide.summary or definition.description or 'See the raw schema for this definition.' }}</p>
        {% if definition.properties %}
          {{ fieldTable(definition.properties, name, 'v04Utilities') }}
        {% elif definition.additionalProperties and definition.additionalProperties.properties %}
          {{ fieldTable(definition.additionalProperties.properties, name + 'Entry', 'v04Utilities') }}
        {% elif definition.additionalProperties === true %}
          <p>This definition accepts type-specific keys, described in the raw schema.</p>
        {% elif definition.$ref %}
          <p><code>{{ definition.$ref }}</code></p>
        {% elif definition.type %}
          <p><code>{{ definition.type }}</code>
          {% if definition.description %} — {{ definition.description }}{% endif %}
          </p>
        {% endif %}
      </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

