---
layout: docs.njk
permalink: /docs/schemas/v0.4/icons/
title: Icons — v0.4
description: JSON Schema reference for the Design Lasagna v0.4 icons manifest.
schemaDocVersion: v0.4
docsToc:
  - label: Manifest fields
    href: "#manifest-fields"
  - label: Icon fields
    href: "#icon-fields"
  - label: Nested definitions
    href: "#definitions"
---
{%- set st = schemas.v04Icons -%}
{%- set ref = st.ref -%}
{%- set icon = ref.definitions.Icon -%}

{% from "schema-field-table.njk" import fieldTable with context %}

<section>
  <p class="eyebrow">Schemas / v0.4</p>
  <h1>Icons</h1>
  <p class="lede">{{ ref.description }}</p>
  {% include "schema-version-nav.njk" %}
  <aside class="schema-install" aria-labelledby="use-icons-schema">
    <div class="schema-install__intro">
      <h2 id="use-icons-schema">Use this schema</h2>
      <p>Set <code>$schema</code> in an icons manifest to enable validation and editor support.</p>
      <p>The reference below is generated from the published schema and augmented with reader guidance.</p>
    </div>
    <dl class="schema-install__sources">
      <div><dt>Raw schema</dt><dd><a href="{{ st.canonicalUrl }}">{{ st.canonicalUrl }}</a></dd></div>
      <div><dt>npm</dt><dd><a href="https://www.npmjs.com/package/@designlasagna/schemas"><code>{{ st.npmImportPath }}</code></a></dd></div>
      <div><dt>Repository</dt><dd><a href="https://github.com/designlasagna/schemas">designlasagna/schemas</a></dd></div>
    </dl>
  </aside>
  <h2>Minimal example</h2>
  <p>This manifest declares the minimal resolved icons list. Each icon requires a
  <code>name</code> and at least one <code>platforms</code> entry, and each platform
  entry must assert exactly one of <code>import</code>, <code>usage</code>, or
  <code>component</code>.</p>
  <pre class="json-example" tabindex="0"><code>{{ st.minimalExample | jsonCode | safe }}</code></pre>
</section>
<section id="manifest-fields">
  <h2>Manifest fields</h2>
  <p>The root object is the resolved icons manifest. Required fields are marked with <code>*</code>.</p>
  {{ fieldTable(ref.properties, 'manifest', 'v04Icons') }}
</section>

<section id="icon-fields">
  <h2>Icon fields</h2>
  <p>Each item in <code>icons</code> follows this shape.</p>
  {{ fieldTable(icon.properties, 'Icon', 'v04Icons') }}
</section>

<section id="definitions">
  <h2>Nested definitions</h2>
  <p>Reusable shapes referenced by the fields above.</p>
  <div class="schema-definition-list">
    {% for name, definition in ref.definitions | dictsort %}
      {% if name != 'Icon' %}
      <article class="schema-definition">
        <h3 id="definition-{{ name }}"><code>{{ name }}</code></h3>
        {% set definitionGuide = schemaDocs.v04Icons._definitions and schemaDocs.v04Icons._definitions[name] or {} %}
        <p>{{ definitionGuide.summary or definition.description or 'See the raw schema for this definition.' }}</p>
        {% if definition.properties %}
          {{ fieldTable(definition.properties, name, 'v04Icons') }}
        {% elif definition.additionalProperties and definition.additionalProperties.properties %}
          {{ fieldTable(definition.additionalProperties.properties, name + 'Entry', 'v04Icons') }}
        {% elif definition.additionalProperties === true %}
          <p>This definition accepts type-specific keys, described in the raw schema.</p>
        {% elif definition.$ref %}
          <p><code>{{ definition.$ref }}</code></p>
        {% elif definition.type %}
          <p><code>{{ definition.type }}</code>
          {% if definition.description %} — {{ definition.description }}{% endif %}
          </p>
        {% endif %}
      </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

<p><a class="link-back" href="/docs/schemas/">All schemas</a></p>
