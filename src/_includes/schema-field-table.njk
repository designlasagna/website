{#-
  Shared field table for the schema reference pages.
  Import with context so schemaDocs (global data) is visible:
    {% from "schema-field-table.njk" import fieldTable with context %}

  fieldTable(fields, scope, docsKey, showDetails=true, metaInDetails=false)
    fields         array of { name, type, $ref, ... } schema properties
    scope          key into schemaDocs[docsKey] and prefix for toggle ids
    docsKey        schemaDocs entry for this page, e.g. "v04Tokens"
    showDetails    false renders a static name cell and no expandable row
    metaInDetails  true moves Allowed/Default/Values into the expandable row
                   (v0.3 DTCG extensions layout) instead of the cells
-#}
{% macro fieldTable(fields, scope, docsKey, showDetails=true, metaInDetails=false) %}
{% set inlineMeta = (not metaInDetails) or (not showDetails) %}
<div class="schema-table-wrap">
  <table class="schema-table">
    <thead>
      <tr>
        <th>Field</th>
        <th>Type</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {% for field in fields %}
      {% set scopeDocs = schemaDocs[docsKey][scope] or {} %}
      {% set guide = scopeDocs[field.name] or {} %}
      <tr class="field-row">
        <td class="field-name-cell">
          {% if showDetails %}
          <div class="field-name-toggle-wrap">
            <input class="field-toggle" id="field-details-{{ scope }}-{{ loop.index }}" type="checkbox" aria-label="Show details for {{ field.name }}">
            <label class="field-name-toggle" for="field-details-{{ scope }}-{{ loop.index }}">
              <span class="field-chevron" aria-hidden="true"></span>
              <code>{{ field.name }}{% if field.required %}<span class="required-field" aria-label="required">*</span>{% endif %}</code>
              {% if field.deprecated %}<span class="field-status field-status--deprecated">Deprecated</span>{% endif %}
            </label>
          </div>
          {% else %}
          <div class="field-name-static"><code>{{ field.name }}{% if field.required %}<span class="required-field" aria-label="required">*</span>{% endif %}</code>{% if field.deprecated %} <span class="field-status field-status--deprecated">Deprecated</span>{% endif %}</div>
          {% endif %}
        </td>
        <td>
          {% if field.type %}
            {% if field.type is string %}<code>{{ field.type }}</code>{% else %}<code>{{ field.type | join(', ') }}</code>{% endif %}
            {% if inlineMeta and field.additionalProperties and field.additionalProperties.$ref %}
              {% set valueDefinition = field.additionalProperties.$ref | schemaDefinitionName %}
              <br>values: {% if valueDefinition %}<a class="schema-ref" href="#definition-{{ valueDefinition }}"><code>{{ valueDefinition }}</code></a>{% else %}<code>{{ field.additionalProperties.$ref }}</code>{% endif %}
            {% endif %}
          {% elif field.$ref %}
            {% set fieldDefinition = field.$ref | schemaDefinitionName %}
            {% if fieldDefinition %}<a class="schema-ref" href="#definition-{{ fieldDefinition }}"><code>{{ fieldDefinition }}</code></a>{% else %}<code>{{ field.$ref }}</code>{% endif %}
          {% else %}—{% endif %}
        </td>
        <td>
          {{ guide.summary or field.description or '—' }}
          {% if inlineMeta %}
          {% if field.enum %}<br>Allowed: <code>{{ field.enum.values | join(', ') }}</code>{% endif %}
          {% if field.default !== undefined %}<br>Default: <code>{{ field.default }}</code>{% endif %}
          {% endif %}
        </td>
      </tr>
      {% if showDetails %}
      <tr class="field-details">
        <td colspan="3">
          <div class="field-details__content">
            <div>
              {% if guide.useWhen %}<p><strong>Use when:</strong> {{ guide.useWhen }}</p>{% endif %}
              {% if guide.provenance %}<p><strong>Origin:</strong> {{ guide.provenance }}</p>{% endif %}
              {% if guide.related and guide.related.length %}<p><strong>Related:</strong> {% for related in guide.related %}<code>{{ related }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
              {% if not inlineMeta %}
              {% if field.enum %}<p><strong>Allowed:</strong> <code>{{ field.enum.values | join(', ') }}</code></p>{% endif %}
              {% if field.default !== undefined %}<p><strong>Default:</strong> <code>{{ field.default }}</code></p>{% endif %}
              {% if field.additionalProperties and field.additionalProperties.$ref %}{% set valueDefinition = field.additionalProperties.$ref | schemaDefinitionName %}<p><strong>Values:</strong> {% if valueDefinition %}<a class="schema-ref" href="#definition-{{ valueDefinition }}"><code>{{ valueDefinition }}</code></a>{% else %}<code>{{ field.additionalProperties.$ref }}</code>{% endif %}</p>{% endif %}
              {% endif %}
            </div>
            {% if guide.example %}<div><p><strong>Example usage</strong></p><pre class="json-example"><code>{{ guide.example | jsonCode | safe }}</code></pre></div>{% endif %}
          </div>
        </td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}
