<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/logotype.svg' | url }}">
  {% if page.url %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">{% endif %}
  <meta property="og:title" content="{% if title and title != site.title %}{{ title }} — {% endif %}{{ site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {% shareImageMeta hero %}
  {%- set shareImage = hero | heroImage %}
  {%- if ogType == "article" %}
  <meta property="article:published_time" content="{{ page.date | dateISO }}">
  {%- for tag in tags | writingTags %}
  <meta property="article:tag" content="{{ tag }}">
  {%- endfor %}
  <script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "BlogPosting", "headline": title, "description": description, "datePublished": page.date | dateISO, "image": (site.url + shareImage.src) if shareImage else undefined, "url": site.url + page.url, "keywords": tags | writingTags, "author": { "@type": "Organization", "name": site.title, "url": site.url }, "publisher": { "@type": "Organization", "name": site.title, "url": site.url } } | jsonLd | safe }}</script>
  {%- endif %}
  {%- if draft %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {%- if page.url and page.url.startsWith("/writing/") %}
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} — Writing" href="/writing/feed.xml">
  {%- endif %}
  <title>{% if title and title != site.title %}{{ title }} — {% endif %}{{ site.title }}</title>
  <link rel="preload" as="font" type="font/woff2" href="{{ '/assets/fonts/tilt-warp-400.woff2' | url }}" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="{{ '/assets/fonts/dm-sans-variable.woff2' | url }}" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Design Lasagna home"><img src="{{ '/assets/logotype.svg' | url }}" alt="Design Lasagna" width="213" height="202"></a>
    <nav class="site-nav" aria-label="Main">
      {%- for link in site.nav %}
      {%- if not link.section or sections[link.section] %}
      <a href="{{ link.href }}"{% if page.url and link.href == page.url %} aria-current="page"{% elif page.url and link.href != "/" and page.url.startsWith(link.href) %} aria-current="true"{% endif %}>{{ link.label }}</a>
      {%- endif %}
      {%- endfor %}
    </nav>
  </header>
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <nav aria-label="Footer">
      {% for link in site.external %}
      <a href="{{ link.href }}">{{ link.label }}</a>
      {% endfor %}
    </nav>
    <p class="site-footer__note">{{ site.description }}</p>
  </footer>
</body>
</html>
