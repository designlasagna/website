---
layout: base.njk
---
<div class="docs-shell">
  <aside class="docs-sidebar">
    <details class="docs-sidebar__menu" open>
      <summary>Documentation navigation</summary>
      <nav aria-label="Documentation">
        <a href="/docs/">Docs home</a>

        <div class="docs-sidebar__group" role="group" aria-label="Schema reference">
          <p class="docs-sidebar__heading">Schema reference</p>
          <a href="/docs/schemas/">Schema overview</a>
          <a href="/docs/schemas/v0.4/tokens/"{% if page.url == '/docs/schemas/v0.4/tokens/' %} aria-current="page"{% endif %}>Tokens</a>
          {% if page.url == '/docs/schemas/v0.4/tokens/' and docsToc %}<div class="docs-sidebar__subnav" aria-label="Tokens sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
          <a href="/docs/schemas/v0.4/utilities/"{% if page.url == '/docs/schemas/v0.4/utilities/' %} aria-current="page"{% endif %}>Utilities</a>
          {% if page.url == '/docs/schemas/v0.4/utilities/' and docsToc %}<div class="docs-sidebar__subnav" aria-label="Utilities sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
          <a href="/docs/schemas/v0.4/icons/"{% if page.url == '/docs/schemas/v0.4/icons/' %} aria-current="page"{% endif %}>Icons</a>
          {% if page.url == '/docs/schemas/v0.4/icons/' and docsToc %}<div class="docs-sidebar__subnav" aria-label="Icons sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
          <a href="/docs/schemas/v0.4/components/"{% if page.url == '/docs/schemas/v0.4/components/' %} aria-current="page"{% endif %}>CEM extensions</a>
          {% if page.url == '/docs/schemas/v0.4/components/' and docsToc %}<div class="docs-sidebar__subnav" aria-label="CEM extensions sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
          <a href="/docs/schemas/v0.4/dtcg-extensions/"{% if page.url == '/docs/schemas/v0.4/dtcg-extensions/' %} aria-current="page"{% endif %}>DTCG extensions</a>
          {% if page.url == '/docs/schemas/v0.4/dtcg-extensions/' and docsToc %}<div class="docs-sidebar__subnav" aria-label="DTCG extensions sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
          <a href="/docs/schemas/v0.4/lifecycle/"{% if page.url == '/docs/schemas/v0.4/lifecycle/' %} aria-current="page"{% endif %}>Lifecycle</a>
          {% if page.url == '/docs/schemas/v0.4/lifecycle/' and docsToc %}<div class="docs-sidebar__subnav" aria-label="Lifecycle sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
        </div>

        <div class="docs-sidebar__group" role="group" aria-label="Versioning">
          <p class="docs-sidebar__heading">Versioning</p>
          <a href="/docs/schemas/migrate-v0.3-to-v0.4/"{% if page.url == '/docs/schemas/migrate-v0.3-to-v0.4/' %} aria-current="page"{% endif %}>Migrate v0.3 → v0.4</a>
          {% if page.url == '/docs/schemas/migrate-v0.3-to-v0.4/' and docsToc %}<div class="docs-sidebar__subnav" aria-label="Migration sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
        </div>

        {% if schemaDocVersion == 'v0.3' %}
        <div class="docs-sidebar__group" role="group" aria-label="Previous version">
          <p class="docs-sidebar__heading">Previous version</p>
          <a href="{{ page.url }}" aria-current="page">{{ navLabel or title }}</a>
          {% if docsToc %}<div class="docs-sidebar__subnav" aria-label="{{ navLabel or title }} sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
        </div>
        {% endif %}

        <div class="docs-sidebar__group" role="group" aria-label="Language Server">
          <p class="docs-sidebar__heading">Language Server</p>
          <a href="/docs/language-server/"{% if page.url == '/docs/language-server/' %} aria-current="page"{% endif %}>Install and configure</a>
          {% if page.url == '/docs/language-server/' and docsToc %}<div class="docs-sidebar__subnav" aria-label="Language Server sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
          <a href="/tools/language-server/">Tool overview</a>
        </div>
      </nav>
    </details>
  </aside>
  <article class="docs-content">
    {{ content | safe }}
  </article>
</div>
<script>
  // Progressive enhancement: keep the nested section navigation aligned with
  // the reader's scroll position. The native anchor behaviour remains useful
  // when JavaScript is unavailable.
  (() => {
    // Keep the no-JavaScript navigation available; on phones, let readers
    // reach the reference before expanding the full documentation menu.
    const menu = document.querySelector('.docs-sidebar__menu');
    const wideScreen = matchMedia('(min-width: 64rem)');
    const syncMenu = () => { menu.open = wideScreen.matches; };
    syncMenu();
    wideScreen.addEventListener('change', syncMenu);
    document.documentElement.classList.add('docs-scroll-nav');
    const links = [...document.querySelectorAll('.docs-sidebar__subnav a[href^="#"]')];
    const entries = links.map((link) => ({
      link,
      section: document.getElementById(decodeURIComponent(link.hash.slice(1))),
    })).filter(({ section }) => section);
    if (!entries.length) return;

    const update = () => {
      const readingLine = 180;
      let active = null; // Above the first section (the page header), mark nothing.
      for (const entry of entries) {
        if (entry.section.getBoundingClientRect().top <= readingLine) active = entry;
      }
      for (const entry of entries) {
        if (entry === active) entry.link.setAttribute('aria-current', 'location');
        else entry.link.removeAttribute('aria-current');
      }
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  })();
</script>
