---
layout: base.njk
---
{%- if docsToc %}
<style>
  /* No-JS fallback: highlight the section link matching the URL fragment.
     Generated from this page's docsToc so no per-section CSS is needed. */
  {% for item in docsToc %}html:not(.docs-scroll-nav) .docs-shell:has({{ item.href }}:target) .docs-sidebar__subnav a[href="{{ item.href }}"]{% if not loop.last %},{% endif %}
  {% endfor %}{ color: var(--purple) !important; font-weight: 500; text-decoration: underline; text-decoration-color: currentColor; text-decoration-thickness: 2px; text-underline-offset: .3em; }
</style>
{%- endif %}
<div class="docs-shell">
  <aside class="docs-sidebar">
    <details class="docs-sidebar__menu" open>
      <summary>Documentation navigation</summary>
      <nav aria-label="Documentation">
        <a href="{{ docsNav.home.href }}"{% if page.url == docsNav.home.href %} aria-current="page"{% endif %}>{{ docsNav.home.label }}</a>

        {% for group in docsNav.groups %}
        {% if group.previousVersion %}
        {% if schemaDocVersion == 'v0.3' %}
        <div class="docs-sidebar__group" role="group" aria-label="{{ group.heading }}">
          <p class="docs-sidebar__heading">{{ group.heading }}</p>
          <a href="{{ page.url }}" aria-current="page">{{ navLabel or title }}</a>
          {% if docsToc %}<div class="docs-sidebar__subnav" aria-label="{{ navLabel or title }} sections">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
        </div>
        {% endif %}
        {% else %}
        <div class="docs-sidebar__group" role="group" aria-label="{{ group.heading }}">
          <p class="docs-sidebar__heading">{{ group.heading }}</p>
          {% for link in group.links %}
          <a href="{{ link.href }}"{% if page.url == link.href %} aria-current="page"{% endif %}>{{ link.label }}</a>
          {% if link.sections and page.url == link.href and docsToc %}<div class="docs-sidebar__subnav" aria-label="{{ link.sections }}">{% for item in docsToc %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
          {% endfor %}
        </div>
        {% endif %}
        {% endfor %}
      </nav>
    </details>
  </aside>
  <article class="docs-content">
    {{ content | safe }}
  </article>
</div>
<script>
  // Progressive enhancement: keep the nested section navigation aligned with
  // the reader's scroll position. The native anchor behaviour remains useful
  // when JavaScript is unavailable.
  (() => {
    // Keep the no-JavaScript navigation available; on phones, let readers
    // reach the reference before expanding the full documentation menu.
    const menu = document.querySelector('.docs-sidebar__menu');
    const wideScreen = matchMedia('(min-width: 64rem)');
    const syncMenu = () => { menu.open = wideScreen.matches; };
    syncMenu();
    wideScreen.addEventListener('change', syncMenu);
    document.documentElement.classList.add('docs-scroll-nav');
    const links = [...document.querySelectorAll('.docs-sidebar__subnav a[href^="#"]')];
    const entries = links.map((link) => ({
      link,
      section: document.getElementById(decodeURIComponent(link.hash.slice(1))),
    })).filter(({ section }) => section);
    if (!entries.length) return;

    const update = () => {
      const readingLine = 180;
      let active = null; // Above the first section (the page header), mark nothing.
      for (const entry of entries) {
        if (entry.section.getBoundingClientRect().top <= readingLine) active = entry;
      }
      for (const entry of entries) {
        if (entry === active) entry.link.setAttribute('aria-current', 'location');
        else entry.link.removeAttribute('aria-current');
      }
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  })();
</script>
